# Demo mode: when true, the app makes ZERO backend and ZERO AI requests.
# Everything is served from bundled sample content + your browser's local storage.
# Leave unset for local development (defaults to false in dev, true in production builds).
VITE_DEMO_MODE=true

# Required only when VITE_DEMO_MODE=false (real backend + AI path).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
